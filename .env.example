# Gnani API key from https://app.gnani.ai/voice
GNANI_API_KEY=

# Prisma STT
STT_MODEL=prisma-v3.0
STT_LANG=indic-auto
STT_SAMPLE_RATE=16000
STT_PARTIALS=true

# Timbre TTS
TTS_MODEL=timbre-v3.0
TTS_VOICE=Shivani
TTS_VOICE_MALE=Avinash
TTS_VOICE_FEMALE=Shivani

# Resume writer: any OpenAI-compatible chat completions API.
# Examples: https://api.openai.com/v1, https://generativelanguage.googleapis.com/v1beta/openai,
# https://api.groq.com/openai/v1, https://openrouter.ai/api/v1, or a self-hosted Evon/vLLM server.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
