# Gnani API key from https://app.gnani.ai/voice
GNANI_API_KEY=

# Prisma STT
STT_MODEL=prisma-v3.0
STT_LANG=indic-auto
STT_SAMPLE_RATE=16000
STT_PARTIALS=true

# Timbre TTS
TTS_MODEL=timbre-v3.0
TTS_VOICE=Shivani
TTS_VOICE_MALE=Avinash
TTS_VOICE_FEMALE=Shivani

# Resume writer: any OpenAI-compatible chat completions API.
# Examples: https://api.openai.com/v1, https://generativelanguage.googleapis.com/v1beta/openai,
# https://api.groq.com/openai/v1, https://openrouter.ai/api/v1, or a self-hosted Evon/vLLM server.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=
# Optional: "low" makes reasoning models answer faster (Gemini 3.5 Flash: ~4 s vs ~10 s)
LLM_REASONING_EFFORT=

# Storage. Defaults to local disk in ./data. On hosts that wipe files on
# restart (e.g. Render free), use an S3-compatible bucket instead:
#   Cloudflare R2:  S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com  S3_REGION=auto
#   Backblaze B2:   S3_ENDPOINT_URL=https://s3.<region>.backblazeb2.com  S3_REGION=<region>
S3_BUCKET=
S3_ENDPOINT_URL=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Deployment limits (optional)
# DATA_DIR=/data
# MAX_ANSWER_SECONDS=180
# MAX_LISTEN_SESSIONS=4
# PROFILES_PER_IP_PER_HOUR=10
